4-- Create a function that takes a Student ID as input and retrieves all
--information related to that student
CREATE  FUNCTION student_info(student_id int)
RETURNS TABLE (
 st_id int  ,
name varchar(20),
gender varchar(1) ,
birth_date date ,
track_id int 
) AS $$
BEGIN
  RETURN QUERY
  SELECT 
    student.st_id,
    student.name,
    student.gender,
    student.birth_date,
    student.track_id
  FROM student
  WHERE student.st_id = student_id;
END;
$$ LANGUAGE plpgsql;
select student_info(1);
