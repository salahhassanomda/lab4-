--5. Implement a function that takes the name of a subject and calculates
--the average grades for that subject
CREATE FUNCTION average_grade2(sub_name TEXT)
RETURNS numeric AS $$
DECLARE
  avg_grade numeric;
BEGIN
  SELECT AVG(grades.grade)
  INTO avg_grade
  FROM subject
  JOIN grades ON grades.sub_id = subject.id
  WHERE subject.name = sub_name;

  RETURN avg_grade;
END;
$$ LANGUAGE plpgsql;

