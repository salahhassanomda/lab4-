--7. Create a trigger to monitor changes made to the student table,
--including additions, updates, and deletions. This trigger will record
--the time of each action and provide a description of the action in
--another table.
CREATE TABLE student_edit (
  log_id SERIAL PRIMARY KEY,
  student_id INT,
  action_type TEXT,
  action_time TIMESTAMP,
  description TEXT);

CREATE  FUNCTION student_log()
RETURNS TRIGGER AS $$
BEGIN
  IF TG_OP = 'INSERT' THEN
    INSERT INTO student_edit (student_id, action_type, description)
    VALUES (NEW.id, 'INSERT', 'New student added');

  ELSIF TG_OP = 'UPDATE' THEN
    INSERT INTO student_edit (student_id, action_type, description)
    VALUES (NEW.id, 'UPDATE', 'Student record updated');

  ELSIF TG_OP = 'DELETE' THEN
    INSERT INTO student_edit (student_id, action_type, description)
    VALUES (OLD.id, 'DELETE', 'Student record deleted');
  END IF;

  RETURN NULL;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER student_changes
AFTER INSERT OR UPDATE OR DELETE ON student
FOR EACH ROW
EXECUTE FUNCTION student_log();


